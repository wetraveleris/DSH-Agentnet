[Unit]
Description=Avatar (DeepSeek Harness) resident agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/avatar
EnvironmentFile=/etc/avatar.env
Environment=HOME=/root
ExecStart=/opt/avatar/node_modules/.bin/dsh avatar --no-open --port 50999
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
