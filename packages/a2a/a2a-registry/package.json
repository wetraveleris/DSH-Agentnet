{
  "name": "@deepseek-ai/dsh-a2a-registry",
  "description": "Public Agent Card registry for DeepSeek Harness A2A peer discovery",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/a2a/a2a-registry" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/bin.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": { "express": "^5.1.0" },
  "peerDependencies": { "@deepseek-ai/dsh-invariants": "workspace:^", "@deepseek-ai/cordis": "workspace:^" },
  "devDependencies": { "@types/express": "^5.0.3", "@deepseek-ai/dsh-invariants": "workspace:^", "@deepseek-ai/cordis": "workspace:^" },
  "bin": { "dsh-a2a-registry": "lib/bin.js" }
}
