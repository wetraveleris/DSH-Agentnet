{
  "name": "@deepseek-ai/dsh-a2a-bundle",
  "description": "Opt-in profile bundle for the DSH A2A network capability",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/bundle/a2a-bundle" },
  "type": "module",
